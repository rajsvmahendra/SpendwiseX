# =============================================================
# SpendWise — Git Ignore Rules
# =============================================================

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environment ──────────────────────────────────
venv/
env/
.env/
.venv/

# ── Database ─────────────────────────────────────────────
# budget.db is auto-created on first run.
# It should NOT be committed because:
#   1. It contains user data
#   2. It is binary (causes merge conflicts)
#   3. init_db() recreates it with correct schema
budget.db
*.db-journal
*.db-wal
*.db-shm

# ── IDE / Editor ─────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── OS files ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ── Tesseract / OCR temporary files ──────────────────────
*.traineddata
tesseract_temp/